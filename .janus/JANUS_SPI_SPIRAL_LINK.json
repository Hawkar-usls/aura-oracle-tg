    "AURA_OUTPUT != PREDICTIVE_GROUND_TRUTH",
    "ASSOCIATION != EVIDENCE",
    "QUESTION_INFORMATION_GAIN != ANSWER_TRUTH",
    "POSITION_MAY_REPEAT_BUT_STATE_MUST_ADVANCE",
